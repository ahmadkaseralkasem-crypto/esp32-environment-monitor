{
    "name": "Weather Cloud Monitor",
    "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
    "containerEnv": {
        "HOST": "0.0.0.0",
        "PORT": "8000",
        "MIDDLEWARE_URL": "http://127.0.0.1:8000"
    },
    "forwardPorts": [
        8000
    ],
    "portsAttributes": {
        "8000": {
            "label": "Weather Cloud Monitor API",
            "onAutoForward": "openBrowser"
        }
    },
    "postCreateCommand": "python -m pip install -r requirements.txt",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.debugpy"
            ]
        }
    }
}
