# Local mode works immediately and stores readings in data/weather_readings.db.
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/weather_readings.db

# Collector settings
MIDDLEWARE_URL=http://127.0.0.1:8000
MIDDLEWARE_API_KEY=
WEATHER_LATITUDE=52.5200
WEATHER_LONGITUDE=13.4050
FETCH_INTERVAL_SECONDS=900

# Change STORAGE_BACKEND to supabase after creating the cloud table.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_TABLE=weather_readings

# Middleware server
HOST=127.0.0.1
PORT=8000
